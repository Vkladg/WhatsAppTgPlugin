{
  "name": "wt-reader",
  "version": "1.0.0",
  "description": "Read-only Telegram + WhatsApp reader for AI agents (CLI + MCP server). No send/edit/delete by design.",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "wt": "src/cli.js"
  },
  "scripts": {
    "login:tg": "node src/cli.js login-tg",
    "qr:tg": "node src/cli.js qr-tg",
    "link:wa": "node src/cli.js link-wa",
    "mcp": "node src/mcp-server.mjs",
    "doctor": "node src/cli.js doctor",
    "check": "node --check src/cli.js && node --check src/util.js && node --check src/store.js && node --check src/core/telegram.js && node --check src/core/whatsapp.js && node --check src/mcp-server.mjs"
  },
  "keywords": [
    "telegram",
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "codex",
    "read-only",
    "message-reader"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vkladg/WhatsAppTgPlugin.git"
  },
  "bugs": {
    "url": "https://github.com/Vkladg/WhatsAppTgPlugin/issues"
  },
  "homepage": "https://github.com/Vkladg/WhatsAppTgPlugin#readme"
}
